# ---- LeadFlow backend ----
PORT=5000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=leadflow

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10

# CORS (comma separated origins)
CLIENT_ORIGINS=http://localhost:5173,http://localhost:3000

# Uploads
MAX_UPLOAD_MB=10
